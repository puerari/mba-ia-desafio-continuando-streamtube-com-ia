FROM node:25.6.0-slim

# ffmpeg ships ffprobe too — both are spawned directly by FfmpegService.
# This is the only image that carries them; the API never transcodes.
RUN apt update && apt install -y procps curl ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ]
